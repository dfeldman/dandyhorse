{
  "schemaVersion": 1,
  "id": "mockgame",
  "name": "Mock Game",
  "version": "0.1.0",
  "author": "Dandyhorse",
  "description": "Exercises every platform API without hardware.",
  "entry": "index.html",
  "screenshot": "screenshot.png",
  "minPlatformVersion": "1.0",
  "capabilities": {
    "seed": true,
    "ghosts": false,
    "input": true,
    "saveState": true,
    "routes": [
      "Loop"
    ]
  },
  "achievements": {
    "first_lap": {
      "name": "First lap",
      "description": "Finished a lap of the loop."
    },
    "speed_10ms": {
      "name": "Speed demon",
      "description": "Went faster than 10 m/s."
    }
  },
  "stats": {
    "laps": {
      "label": "Laps",
      "better": "higher",
      "leaderboard": true
    },
    "prompts": {
      "label": "Questions answered",
      "better": "higher"
    }
  },
  "progress": {
    "laps": {
      "label": "Laps"
    }
  },
  "variants": [
    {
      "id": "treadmill",
      "name": "Mock Game",
      "description": "Exercises every platform API on a treadmill.",
      "deviceTypes": [
        "treadmill"
      ],
      "defaultDuration": 600,
      "controls": {
        "treadmill": "incline"
      }
    },
    {
      "id": "treadmill-speed",
      "name": "Mock Game (game-controlled speed)",
      "description": "Same course, but the game also commands belt speed. For testing the speed pipeline.",
      "deviceTypes": [
        "treadmill"
      ],
      "defaultDuration": 600,
      "controls": {
        "treadmill": "speed+incline"
      }
    },
    {
      "id": "bike",
      "name": "Mock Game",
      "description": "Exercises every platform API on a bike trainer.",
      "deviceTypes": [
        "bike"
      ],
      "defaultDuration": 600,
      "controls": {
        "bike": "grade"
      }
    }
  ],
  "preferencesSchema": {
    "type": "object",
    "properties": {
      "showMinimap": {
        "type": "boolean",
        "default": true,
        "description": "Draw the route minimap and elevation profile."
      }
    }
  }
}
