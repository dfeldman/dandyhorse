{
  "name": "trailtrainer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node tools/link-assets.js dist",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bake": "node tools/bake.ts",
    "profile": "node tools/profile.ts",
    "shots": "node --experimental-strip-types tools/shots.ts",
    "textures": "node --experimental-strip-types tools/textures.ts",
    "canopies": "node --experimental-strip-types tools/canopies.ts",
    "water": "node --experimental-strip-types tools/water.ts",
    "look": "node --experimental-strip-types tools/look.ts",
    "bench": "node --experimental-strip-types tools/bench.ts",
    "stutter": "node tools/stutter.mjs",
    "postinstall": "node ../../scripts/link-siblings.mjs avatarkit=AVATARKIT_DIR:../../../avatarkit"
  },
  "dependencies": {
    "@babylonjs/core": "9.26.0",
    "@babylonjs/loaders": "^9.26.0"
  },
  "devDependencies": {
    "@types/node": "^24",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.8",
    "vite": "^7",
    "vitest": "^3.2"
  }
}
