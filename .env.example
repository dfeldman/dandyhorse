# Dandyhorse server credentials: copy to .env (git-ignored) at the repo root and fill in. Never commit .env.
# Google sign-in (OAuth web client, console.cloud.google.com → Credentials). Set both to switch the server to Google
# sign-in; leave them empty for the development stub.
DANDYHORSE_GOOGLE_CLIENT_ID=
DANDYHORSE_GOOGLE_CLIENT_SECRET=
# where people reach the server, e.g. https://dandyhorse.example.com
DANDYHORSE_PUBLIC_URL=
